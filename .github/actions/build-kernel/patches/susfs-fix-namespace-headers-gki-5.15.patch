From: oplus-sukisu_kernel maintainers
Subject: [PATCH] fs/namespace: re-apply the SUSFS header block for android13-5.15

The 50_add_susfs_in_gki-android13-5.15.patch hunk that adds the SUSFS includes
and the SUS_MOUNT externs to fs/namespace.c carries

    #include <trace/hooks/blk.h>

as a context line. The OnePlus 5.15 trees have no include/trace/hooks/
directory at all, so the hunk rejects on every android13-5.15 profile even
though the change it makes is unrelated to that include.

This re-applies the same two blocks against the vendor context. Nothing is
added that the upstream patch does not add; the only difference is the context
line the vendor tree cannot provide.

The build applies this only when fs/namespace.c.rej exists.

diff --git a/fs/namespace.c b/fs/namespace.c
--- a/fs/namespace.c
+++ b/fs/namespace.c
@@ -32,9 +32,19 @@
 #include <linux/fs_context.h>
 #include <linux/shmem_fs.h>
 #include <linux/mnt_idmapping.h>
+#ifdef CONFIG_KSU_SUSFS
+#include <linux/susfs_def.h>
+#endif // #ifdef CONFIG_KSU_SUSFS
 
 #include "pnode.h"
 #include "internal.h"
+
+#ifdef CONFIG_KSU_SUSFS_SUS_MOUNT
+extern bool susfs_is_current_ksu_domain(void);
+extern struct static_key_true susfs_is_sdcard_android_data_not_decrypted;
+
+#define CL_COPY_MNT_NS BIT(25) /* used by copy_mnt_ns() */
+#endif // #ifdef CONFIG_KSU_SUSFS_SUS_MOUNT
 
 /* Maximum number of mounts in a mount namespace */
 unsigned int sysctl_mount_max __read_mostly = 100000;
