From: oplus-sukisu_kernel maintainers
Subject: [PATCH] mm: mglru: default min_ttl_ms to 1000 ms (HZ)

Protect the active working set of the last 1000 ms from background
page-cache reclamation thrashing by initializing lru_gen_min_ttl to HZ.
Userspace can still override /sys/kernel/mm/lru_gen/min_ttl_ms at runtime.
---
diff --git a/mm/vmscan.c b/mm/vmscan.c
index 55cba78..8869a4b 100644
--- a/mm/vmscan.c
+++ b/mm/vmscan.c
@@ -4271,7 +4271,7 @@ static bool lruvec_is_reclaimable(struct lruvec *lruvec, struct scan_control *sc
 }
 
 /* to protect the working set of the last N jiffies */
-static unsigned long lru_gen_min_ttl __read_mostly;
+static unsigned long lru_gen_min_ttl __read_mostly = HZ;
 
 static void lru_gen_age_node(struct pglist_data *pgdat, struct scan_control *sc)
 {
